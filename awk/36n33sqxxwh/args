-F'|' -v q="aarty/" '
BEGIN { IGNORECASE=1 }
NR > 1 {
    score = $1
    path  = $2


name = path
sub(/^.*\//, "", name)

if (tolower(name) == tolower(q)) {
    if (best_exact_from_name) {
        if ($1 > best_score) {
            best_score = $1
            best_exact = path
        }
    } else {
        best_exact_from_name = 1
        best_score = $1
        best_exact = path
    }
    next
}

    if (path ~ q && score > best_score) {
        best_score = score
        best = path
    }
}
END {
    if (best_exact != "") print best_exact
    else print best
}
'
