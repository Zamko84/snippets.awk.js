							<execution>
								<id>jspc</id>
								<goals>
									<goal>jspc</goal>
								</goals>
								<configuration>
									<jspc>
										<smapSuppressed>false</smapSuppressed>
										<smapDumped>true</smapDumped>
									</jspc>
									<keepSources>true</keepSources>
									<useProvidedScope>true</useProvidedScope>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
