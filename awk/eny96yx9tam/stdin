				<artifactId>wagon-http</artifactId>
				<version>3.3.1</version>
			</extension>
		</extensions>
		<resources>
			<resource>
				<directory>src/main/java</directory>
				<includes>
					<include>**/*.java</include>
					<include>**/*.xml</include>
					<include>**/*.properties</include>
					<include>**/*.jrxml</include>
				</includes>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.3.0</version>
				<configuration>
					<outputDirectory>dist</outputDirectory>
				</configuration>
				<executions>
					<execution>
						<id>build-adm</id>
						<goals>
							<goal>jar</goal>
						</goals>
						<phase>package</phase>
						<configuration>
							<classifier>adm</classifier>
							<archive>
								<addMavenDescriptor>false</addMavenDescriptor>
								<manifest>
									<addDefaultEntries>false</addDefaultEntries>
								</manifest>
								<manifestEntries>
									<ArtifactID>${project.artifactId}</ArtifactID>
									<ArtifactVersion>${project.version}</ArtifactVersion>
									<App>${project.name}</App>
									<DescripcionApp>${project.description}</DescripcionApp>
									<BuildFecha>${maven.build.timestamp}</BuildFecha>
									<Build-Jdk>${jdk.version}</Build-Jdk>
								</manifestEntries>
							</archive>
							<outputDirectory>dist</outputDirectory>
						</configuration>
					</execution>
					<execution>
						<id>default-jar</id>
						<goals>
							<goal>jar</goal>
						</goals>
						<phase>package</phase>
						<configuration>
							<archive>
								<addMavenDescriptor>false</addMavenDescriptor>
								<manifest>
									<addDefaultEntries>false</addDefaultEntries>
								</manifest>
								<manifestEntries>
									<ArtifactID>${project.artifactId}</ArtifactID>
									<ArtifactVersion>${project.version}</ArtifactVersion>
									<App>${project.name}</App>
									<DescripcionApp>${project.description}</DescripcionApp>
									<BuildFecha>${maven.build.timestamp}</BuildFecha>
									<Build-Jdk>${jdk.version}</Build-Jdk>
								</manifestEntries>
							</archive>
							<outputDirectory>dist</outputDirectory>
							<excludes>
								<exclude>
									**/es/micinn/registroentidades/negocio/adm/*</exclude>
								<exclude>
									**/es/micinn/registroentidades/negocio/impl/adm/*</exclude>
								<exclude>
									**/es/micinn/registroentidades/persistencia/adm/*</exclude>
							</excludes>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<!-- https://www.mojohaus.org/versions/versions-maven-plugin/usage.html -->
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>versions-maven-plugin</artifactId>
				<version>2.16.2</version>
				<configuration>
					<outputFile>pom-updates.log</outputFile>
				</configuration>
				<executions>
					<execution>
						<phase>validate</phase>
						<goals>
							<goal>display-property-updates</goal>
							<goal>display-plugin-updates</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!-- COMPROBADOR DE VERSION MINIMA DE MAVEN Y JAVA-->
			<plugin>
				<artifactId>maven-enforcer-plugin</artifactId>
				<version>3.4.1</version>
				<configuration>
					<!-- https://maven.apache.org/enforcer/enforcer-rules/index.html -->
					<rules>
						<requireMavenVersion>
							<version>${maven.version}</version>
						</requireMavenVersion>
						<requireJavaVersion>
							<version>${java.version}</version>
						</requireJavaVersion>
					</rules>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>enforce</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!-- COMPILADOR -->
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.11.0</version>
				<configuration>
					<source>${jdk.version}</source>
					<target>${jdk.version}</target>
				</configuration>
			</plugin>
			<plugin>
				<artifactId>maven-deploy-plugin</artifactId>
				<version>3.1.1</version>
			</plugin>
			<plugin>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.1.2</version>
				<configuration>
					<reportsDirectory>tests</reportsDirectory>
					<testFailureIgnore>true</testFailureIgnore>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.owasp</groupId>
				<artifactId>dependency-check-maven</artifactId>
				<version>12.1.8</version>
				<configuration>
					<formats>HTML,JSON</formats>
					<nvdApiDelay>6000</nvdApiDelay>
					<nvdApiServerId>nvd</nvdApiServerId>
					<nvdMaxRetryCount>6</nvdMaxRetryCount>
					<nvdValidForHours>72</nvdValidForHours>
					<ossIndexServerId>ossindex</ossIndexServerId>
					<!-- https://raw.githubusercontent.com/Retirejs/retire.js/master/repository/jsrepository.json -->
					<retireJsUrl>file:///${project.basedir}/jsrepository.json</retireJsUrl>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.sonarsource.scanner.maven</groupId>
				<artifactId>sonar-maven-plugin</artifactId>
				 <version>5.2.0.4988</version>
			</plugin>
		</plugins>
	</build>
	<!-- Profiles start here -->
	<profiles>
